{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "scan",
            "pr"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_error_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_error": {
          "type": "string",
          "minLength": 1
        },
        "malformed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "started_at",
        "target",
        "mode"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "enum": [
              "authz_idor",
              "injection",
              "secrets",
              "ssrf",
              "other"
            ]
          },
          "cwe": {
            "type": "string",
            "pattern": "^CWE-\\d+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "reason"
            ],
            "additionalProperties": false
          },
          "exploitability": {
            "type": "string",
            "enum": [
              "theoretical",
              "poc",
              "demonstrated"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "end_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file",
              "start_line"
            ],
            "additionalProperties": false,
            "description": "end_line, when present, must be >= start_line"
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file",
                "line",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "disproof_attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "confirmed",
                    "rejected",
                    "inconclusive"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "role",
                "verdict",
                "summary"
              ],
              "additionalProperties": false
            }
          },
          "validator_verdict": {
            "type": "string",
            "enum": [
              "confirmed",
              "inconclusive"
            ]
          },
          "suggested_fix": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "summary"
            ],
            "additionalProperties": false
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "class",
          "severity",
          "confidence",
          "exploitability",
          "location",
          "root_cause",
          "evidence",
          "disproof_attempts",
          "validator_verdict",
          "suggested_fix",
          "references"
        ],
        "additionalProperties": false
      }
    },
    "disproved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "authz_idor",
              "injection",
              "secrets",
              "ssrf",
              "other"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "class",
          "file",
          "start_line",
          "symbol",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "inconclusive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "authz_idor",
              "injection",
              "secrets",
              "ssrf",
              "other"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "kept": {
            "type": "boolean"
          }
        },
        "required": [
          "class",
          "file",
          "start_line",
          "symbol",
          "reason",
          "kept"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "authz_idor",
              "injection",
              "secrets",
              "ssrf",
              "other"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "error"
          }
        },
        "required": [
          "class",
          "file",
          "start_line",
          "symbol",
          "reason",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "tool",
    "run",
    "findings"
  ],
  "additionalProperties": false
}
