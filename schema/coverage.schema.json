{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "authz_idor",
                  "injection",
                  "secrets",
                  "ssrf"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "hunted",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "class",
              "status",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "route"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "class": {
                "type": "string",
                "enum": [
                  "authz_idor",
                  "injection",
                  "secrets",
                  "ssrf"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "hunted",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "route",
              "line",
              "class",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "target",
    "units"
  ],
  "additionalProperties": false
}
