{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "authz_idor",
                  "injection",
                  "secrets",
                  "ssrf"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "hunted",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "class",
              "status",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "route"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "class": {
                "type": "string",
                "enum": [
                  "authz_idor",
                  "injection",
                  "secrets",
                  "ssrf"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "hunted",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "route",
              "line",
              "class",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "default-exclude",
              "gitignore",
              "exclude",
              "lockfile",
              "minified",
              "snapshot",
              "binary",
              "max-file-bytes",
              "max-files",
              "max-bytes"
            ]
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "discovery": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "handler",
              "middleware",
              "controller",
              "config",
              "fallback"
            ]
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "reviewed",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "start_line",
          "end_line",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "target",
    "units",
    "skipped",
    "discovery"
  ],
  "additionalProperties": false
}
